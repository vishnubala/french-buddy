# ---------------------------------------------------------------------------
# Azure Speech (Text-to-Speech) credentials for generate-audio.mjs.
#
#   1. Copy this file to ".env"  (same folder, exact name, leading dot).
#   2. Paste your real values below.
#   3. NEVER commit ".env" — it is gitignored. This ".env.example" is safe to
#      commit because it holds no real secret.
#
# Get both values from:
#   Azure Portal -> your Speech resource -> "Keys and Endpoint".
#     - Use KEY 1 (KEY 2 is just a spare for rotation).
#     - Region is the short lowercase code shown as "Location/Region",
#       e.g. francecentral or westeurope.
#
# No quotes, no spaces around "=".
# ---------------------------------------------------------------------------
AZURE_SPEECH_KEY=paste-your-key-1-here
AZURE_SPEECH_REGION=francecentral
